#include "resource.h"
#include <windows.h>

IDI_APP ICON "pime.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION 1, 0, 0, 0
    PRODUCTVERSION 1, 0, 0, 0
    FILEFLAGSMASK 0x3fL
    FILEFLAGS 0x0L
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "pime contributors"
            VALUE "FileDescription", "PIME Pinyin Input Method"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "pime"
            VALUE "LegalCopyright", "Copyright (C) 2026 pime contributors"
            VALUE "OriginalFilename", "pime.exe"
            VALUE "ProductName", "PIME Pinyin Input Method"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
